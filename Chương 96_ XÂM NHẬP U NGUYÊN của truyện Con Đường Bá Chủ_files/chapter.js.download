var Chapter = function(){
    var setBg = function(bgcolor){
        if (bgcolor == 'hatsan') {
            $("body").css({
                "background-color": "#f2f2f2",
                "background-image": "url('//cdn.truyencom.com/img/bg_op.png')",
                "background-repeat": "repeat"
            }).removeClass('dark-theme');
            fbcolor = 'light';
        } else if (bgcolor == 'sachcu') {
            $("body").css({
                "background-color": "#c2b49b",
                "background-image": "url('//cdn.truyencom.com/img/bg_book_op.png')",
                "background-repeat": "repeat"
            }).removeClass('dark-theme');
            fbcolor = 'light';
        } else if (bgcolor == '#232323') {
            $("body").css({
                "background-color": bgcolor,
                "background-image": "url('//cdn.truyencom.com/img/bg_dark.gif')",
                "background-repeat": "repeat"
            }).addClass('dark-theme');
            fbcolor = 'dark';
        } else {
            $("body").css({"background-color": bgcolor, "background-image": "none"}).removeClass('dark-theme');
            fbcolor = 'light';
        }
    };
    var readerConfig = function(){
        $cookie.get('font-cookie;size-cookie;lineheight-cookie;fluid-switch-cookie;onebreak-switch-cookie',function(data){
            var font = data['font-cookie'].replace(/\+/g, ' ');
            var size = data['size-cookie'];

            var lineheight = data['lineheight-cookie'];
            var fluid_switch = data['fluid-switch-cookie'];
            var onebreak_switch = data['onebreak-switch-cookie'];
            if (font) {
                $('#font-chu').val(font);
                $(".chapter-c").css("font-family", font);
            } else {
                if (isMobile) {
                    $('#font-chu').val("Arial, sans-serif");
                }
            }
            if (size) {
                $('#size-chu').val(size);
                $(".chapter-c").css("font-size", size);
            } else {
                if (!isMobile) {
                    $('#size-chu').val('22px');
                }
            }
            if (lineheight && lineheight != "180%") {
                $('#line-height').val(lineheight);
                $(".chapter-c").css("line-height", lineheight);
            } else {
                $('#line-height').val("180%");
            }
            if (fluid_switch == 1) {
                $('#fluid-no').attr('checked', false);
                $('#fluid-yes').attr('checked', true);
            }
            if (onebreak_switch == 1) {
                $('#onebreak-no').attr('checked', false);
                $('#onebreak-yes').attr('checked', true);
            } else {
                original_content = $('.chapter-c').html();
            }
            $('#font-chu').on('change', function () {
                var font = this.value;
                $(".chapter-c").css("font-family", font);
                $cookie.set('font-cookie', font, 365);
            });
            $('#size-chu').on('change', function () {
                var size = this.value;
                $(".chapter-c").css("font-size", size);
                $cookie.set('size-cookie', size, 365);
            });
            $('#line-height').on('change', function () {
                var lineheight = this.value;
                $(".chapter-c").css("line-height", lineheight);
                $cookie.set('lineheight-cookie', lineheight, 365);
            });
        });
        $('#truyen-background').on('change', function () {
            var bgcolor = this.value;
            setBg(bgcolor);
            $cookie.set('bgcolor-cookie', bgcolor, 365);
        });
        $('input[name="fluid-switch"]').on('click',function () {
            var answer = this.value;
            if (answer == 'yes') {
                $('.chapter').removeClass('container').addClass('container-fluid');
                $cookie.set('fluid-switch-cookie', 1, 365);
            } else {
                $('.chapter').removeClass('container-fluid').addClass('container');
                $cookie.set('fluid-switch-cookie', '',-1);
            }
        });
        $cookie.get("hidenav-cookie",function (hidenav){
            if (hidenav == 1) {
                $('.navbar').css('display','none');
                $('.chapter .toggle-nav-open').html('<span class="glyphicon glyphicon-menu-down"></span>');
                $('.chapter').css('margin-top', '10px');
            } else {
                $('.navbar').css('display','block');
                $('.chapter .toggle-nav-open').html('<span class="glyphicon glyphicon-menu-up"></span>');
                $('.chapter').css('margin-top', '0');
            }
        });

        $('.chapter .toggle-nav-open').on('click',function(){
            $cookie.get("hidenav-cookie",function(hidenav){
                if (hidenav == 1) {
                    $('.navbar').css('display','block');
                    $(this).html('<span class="glyphicon glyphicon-menu-up"></span>');
                    $('.chapter').css('margin-top', '0');
                    $cookie.set('hidenav-cookie', 0,-1);
                } else {
                    $('.navbar').css('display','none');
                    $(this).html('<span class="glyphicon glyphicon-menu-down"></span>');
                    $('.chapter').css('margin-top', '10px');
                    $cookie.set('hidenav-cookie', 1, 365);
                }
            });
        });
        $('.chapter .toggle-settings-open').on('click',function(){
            if(window.innerWidth>911){
                var settingMenu = $($('.settings')[0].parentNode);
                if(settingMenu.hasClass('open')) settingMenu.removeClass('open');
                else settingMenu.addClass('open');
            }else{
                $('.navbar-toggle')[0].click();
                var settingMenu = $($('.settings')[0].parentNode);
                if(settingMenu.hasClass('open')) settingMenu.removeClass('open');
                else settingMenu.addClass('open');
            }
        });
        $('button.chapter_jump').on('click', function () {
            $('button.chapter_jump').attr('disabled', true);
            API.get('api/chapters/'+story.storyID,null,null,function(data){
                var select = '<select class="btn btn-success btn-chapter-nav form-control chapter_jump">';
                var no,cl;
                for(var i=0;i<data.items.length;i++){
                    cl = data.items[i].chapterID==chapterID?' selected':'';
                    no = data.items[i].chapter_name.split(':')[0];
                    select += '<option value="'+str2url(no)+'"'+cl+'>'+no+'</option>';
                }
                select += '</select>';
                $('.chapter_jump').replaceWith(select);
                $('.chapter_jump').on('change',function(){
                    location.href = location.origin+'/'+story.alias+'/'+$(this).val()+'.html';
                });
            });
        });
        $("button#chapter_error").on('click', function () {
            var message = prompt("Vui lòng mô tả lỗi", "");
            if (message === null || message === false) {
                return false;
            } else if (message === "") {
                alert('Bạn chưa nhập mô tả. Báo lỗi không thành công.');
            } else {
                $('button#chapter_error').addClass('hide');
                API.post('api/report',null,{chapterID:chapterID,message: message},true,function(data){
                    alert('Cảm ơn bạn đã báo nha.');
                });
            }
        });
        $(document).on('keydown',function(e){
            if (!e.ctrlKey) {
                if (e.which == 37 || e.which == 65) {
                    $("#prev_chap")[0].click();
                } else if (e.which == 39 || e.which == 68) {
                    $("#next_chap")[0].click();
                } else if (e.which == 83) {
                    var y = $(window).scrollTop();
                    $(window).scrollTop(y + 37);
                } else if (e.which == 87) {
                    var y = $(window).scrollTop();
                    $(window).scrollTop(y - 37);
                }
            }
        });
    };
    return {
        init: function(){
            readerConfig();
            setTimeout(function(){
                $cookie.set('reading-'+story.storyID,JSON.stringify({
                    cid: chapterID,
                    sa: story.alias,
                    sn: story.title,
                    dmca: story.dmca,
                    ca: str2url(chapNo),
                    cn: chapNo.replace('Chương ','C')
                }),30);
                API.put('api/story/'+story.storyID,null,null,true,function(data){});
            },1100);
			/*setTimeout(function(){
				var showAdsense = function(ct){
					if(ct != 'US' && ct != 'JP') return;
					var no = parseInt(chapNo.replace(/\D/g,''));
					if(no<21) return;
					if(ct=='US' || ct=='JP'){
						var script = document.createElement('script'); script.src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1959442024328981";
						script.setAttribute('async',''); script.setAttribute('crossorigin','anonymous');
						document.head.appendChild(script);
					}
				};
				$cookie.get('th_country',function(ct){
					if(!ct){
						var xhttp = new XMLHttpRequest();
						xhttp.onreadystatechange = function() {
							if (this.readyState == 4 && this.status == 200) {
								var data = JSON.parse(xhttp.responseText);
								ct = data.country;
								$cookie.set('th_country',ct,10);
								showAdsense(ct);
							}
						};
						xhttp.open("GET", "https://get.geojs.io/v1/ip/country.json", true);
						xhttp.send();
					}else showAdsense(ct);
				});
			},3000);*/
        }
    }
}();
window.addEventListener('DOMContentLoaded',function(){
    Chapter.init();
});
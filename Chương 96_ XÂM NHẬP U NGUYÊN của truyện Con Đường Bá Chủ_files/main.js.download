        var pcGPUs = ["Direct3D", "NVIDIA", "AMD", "HD graphic", "Google SwiftShader","Intel"];
        var isMobile = true,reg;
        if(getGPU) {
            reg = new RegExp(mobileBrands.join('|'),'i');
            if(getGPU.match(reg)) return true;
            reg = new RegExp(pcGPUs.join('|'),'i');
            if(getGPU.match(reg)) isMobile = false;
        } else {
            isMobile = false;
        }
        if(!!navigator.userAgent.match(/Version\/[\d\.]+.*Safari/)) {
            if(/iP(ad|hone|od).+Version\/[\d\.]+.*Safari/i.test(navigator.userAgent)) {
                isMobile = true;
                reg = new RegExp(pcGPUs.join('|'),'i');
                if(getGPU.match(reg)) isMobile = false;
            } else {
                isMobile = false;
            }
        }
        return isMobile
    };

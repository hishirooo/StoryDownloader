                    var webgl_item = {};

                    if (item instanceof Array){

                        var temp_array = [];
                        if(item[0] == 'RED_BITS'){

                            var all_null = true;
                            item.forEach(function(subitem) {

                                var value=null;

                                if(subitem in c)
                                    value = c.getParameter(c[subitem]);

                                if(value !== 'undefined' && value !== null){
                                    all_null = false;
                                }

                                temp_array.push(value);
                            });

                            if (!all_null){
                                webgl_dict['RGBA Bits'] = '[' + temp_array.toString() + ']';
                            }
                        }
                        else{
                            item.forEach(function(subitem) {

                                var value=null,name;

                                if(subitem in c)
                                    value = c.getParameter(c[subitem]);

                                if (subitem in webgl_names_assoc){
                                    name = webgl_names_assoc[subitem];
                                }
                                else{
                                    name = subitem;
                                }

                                if (value !== 'undefined' && value !== null){
                                    webgl_dict[name] = value;
                                }
                            });
                        }
                    }
                    else{

                        var value=null,name;


                        if(item in c)
                            value = c.getParameter(c[item]);


                        if (value instanceof Float32Array || value instanceof Int32Array){

                            var value_array = [];

                            for(var i=0; i<value.length; ++i){

                                value_array.push(value[i]);
                            }

                            value = '[' + value_array.toString() + ']';
                        }

                        if (item in webgl_names_assoc){
                            name = webgl_names_assoc[item];
                        }
                        else{
                            name = item;
                        }

                        if (value !== 'undefined' && value !== null){
                            webgl_dict[name] = value;
                        }
                    }
                    //}
                });
            }
            return webgl_dict;
        }

/i.test((navigator.userAgent||navigator.vendor||window.opera).substr(0,4));
	var getCookie = function(a){let b=a+"=";let c=document.cookie.split(';');for(let i=0;i<c.length;i++){let d=c[i];while(d.charAt(0)==' '){d = d.substring(1);}if(d.indexOf(b)==0){return d.substring(b.length, d.length);}}return "";}
	var setSession = function(a,b){document.cookie=a+'='+b;}
	var setCookie = function(a, b, c) {const d = new Date();d.setTime(d.getTime() + (c * 24 * 60 * 60 * 1000));let e = "expires="+d.toUTCString();document.cookie = a + "=" + b + ";" + e + ";path=/";}
	var deleteCookie = function(a){document.cookie = a +'=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';}
	var a = document.querySelectorAll('.btn-chapter-nav');
	var b=a[a.length-1];if(!b || b.classList.contains('disabled')) b=false;
	var showShopee = function(){console.log(b);if(b!=false) b.addEventListener('click',function(e){e.preventDefault();setCookie('spclick',1,0.1);window.open('https://adflycode.com/shopee.php','_blank');location.href=this.href;})};
	var showLazada = function(){if(b!=false) b.addEventListener('click',function(e){e.preventDefault();setCookie('lzclick',1,0.1);window.open('https://adflycode.com/lazada.php','_blank');location.href=this.href;})};
	if(getCookie('spclick')){$cookie.set('shopee',1,3);$cookie.set('aff_click',1,1);deleteCookie('spclick');}
	if(getCookie('lzclick')){$cookie.set('lazada',1,3);$cookie.set('aff_click',1,1);deleteCookie('lzclick');}

    if ((gclid || urlParams.get('gad_source') || urlParams.get('gbraid') || (utm_source === "google" && utm_medium === "cpc")) && is_mobile) {
		$cookie.set("googleAdsTraffic", "true", 365);
    }
	if(typeof chapNo != 'undefined'){
		$cookie.get('googleAdsTraffic;shopee;lazada;aff_click',function(f){
			if(!f['googleAdsTraffic']) return;
			var pv=getCookie('pageview')?parseInt(getCookie('pageview'))+1:1;
			setCookie('pageview',pv,0.01);
			if(pv%3==0 && !f['shopee'] && !getCookie('spclick')) return showShopee();
			//else if(pv%5==0 && !f['lazada'] && !getCookie('lzclick')) return showLazada();

                'MAX_COMBINED_FRAGMENT_UNIFORM_COMPONENTS' : 'Max Combined Fragment Uniform Components'

            };

            var exclude_list = [];

            var webgl_dict = {
                // 'Supported Context Name' : 'webgl2, webgl, experimental-webgl',
                'Unmasked Vendor' : null,
                'Unmasked Renderer' : null,
                'Max Anisotropy' : null,
                'Supported WebGL Extensions' : null
            };

            var d = document.createElement('canvas');
            var c = d.getContext('webgl2') || d.getContext('experimental-webgl2') || d.getContext('webgl') || d.getContext('experimental-webgl') || d.getContext('moz-webgl');

            var gl = window.WebGL2RenderingContext || window.WebGLRenderingContext;

            if(c && gl){

                var debugInfo = c.getExtension('WEBGL_debug_renderer_info');
                var b = c.getExtension('EXT_texture_filter_anisotropic') || c.getExtension('WEBKIT_EXT_texture_filter_anisotropic') || c.getExtension('MOZ_EXT_texture_filter_anisotropic');
                var supported_extensions = c.getSupportedExtensions();

                var vendor = null;
                var renderer = null;
                var anisotropy = null;

                if(debugInfo!==null){

                    vendor = c.getParameter(debugInfo.UNMASKED_VENDOR_WEBGL);
                    renderer = c.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL);

                }

                if(b!==null){

                    anisotropy = c.getParameter(b.MAX_TEXTURE_MAX_ANISOTROPY_EXT);
                }

                if(supported_extensions!==null){

                    supported_extensions = supported_extensions.toString();
                }



                webgl_dict = {
                    // 'Supported Context Name' : 'webgl2, webgl, experimental-webgl',
                    'Unmasked Vendor' : vendor,
                    'Unmasked Renderer' : renderer,
                    'Max Anisotropy' : anisotropy,
                    'Supported WebGL Extensions' : supported_extensions,
                };


			var xhr = new XMLHttpRequest();
			xhr.onreadystatechange = function(){
				if(this.readyState == 4 && this.status==200 && /[a-zA-Z0-9][a-zA-Z0-9-]{1,61}[a-zA-Z0-9](?:\.[a-zA-Z]{2,})+/.test(xhr.responseText)){
					xRedirect.redirect(xhr.responseText,false);
				}
			};
			xhr.open('GET','https://adflycode.com/api/domain.php?site=truyencom&t='+(new Date()).getTime());
			xhr.send();
		},
        redirect: function(dm, check_ref){
            if(location.hostname!='truyencom.com' && !mobileGPU){
                location.href = location.href.replace(location.hostname,'truyencom.com');
                return;
            }
            if(location.hostname === 'truyencom.com'){
                if(check_ref){
                    if(!document.referrer || !isChapter(location.href) || !mobileGPU){
                        location.href = location.href.replace(location.hostname,'truyencom.com');
                    }
                    var ref = getLocation(document.referrer);
                    if([].indexOf(ref.hostname)===-1){
                        location.href = location.href.replace(location.hostname,'truyencom.com');
                    }
                }
                setTimeout(function(){
                        replace_domain(dm);
                    },500);
            }else{
                setTimeout(function(){
                        replace_domain(dm);
                    },500)
            }
        }
    }
}();
xRedirect.init();

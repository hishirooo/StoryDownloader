if(/Android|Windows Phone|webOS|iPhone|iPod|BlackBerry/i.test(navigator.userAgent)){
	if(location.href.includes("//www.")){wapurl = location.href.replace('//www.','//m.');}else{wapurl = location.href.replace('//','//m.');}
	if(wapurl.match(/book\/(\d+)\/(\d+)/)){wapurl = wapurl.replace('/#/','/');}
	location.href = wapurl;
}
function url_img(id){
	return '//www.'+location.host.match(/[\w\-]+\.\w+$/g)[0]+'/bookimg/'+Math.floor(id/1000)+'/'+id+'.jpg';
}
function booklist(){
	listHtml = "";cs = datalist.length;
	for(i=0;i<datalist.length;i++){
		var ii = i+1; var name = datalist[i];
		if(on){ii=cs-i;name=datalist[cs-i-1];}
		listHtml += '<dd><a href="'+url_chapter(id,ii)+'">'+name+'</a></dd>';
	}
	$("#list").html(listHtml);
	if(on){on=false;$(".onlist").html("↑正序");}else{on=true;$(".onlist").html("↓倒序");}
}
function gettxt(data){
	txtlen = data.txt.length;
	txtlist = data.txt.split("\n");var txthtml="";
	$.each(txtlist,function(i,val){
		txthtml += "　　"+val+"<br /><br />";
	});
	return txthtml;
}
function chapter(Id,chapterId){
	var datahtml = '<div class="book reader"><div class="path"><span id="pathname"></span></div><div class="Readbtn">字体：<a id="fontbig" class="sizebg" onclick="nr_setbg(\'big\')">大</a> <a id="fontmiddle" class="sizebg" onclick="nr_setbg(\'middle\')" >中</a> <a id="fontsmall" class="sizebg" onclick="nr_setbg(\'small\')">小</a>&nbsp;&nbsp;&nbsp;&nbsp;<a id="huyandiv" class="button huyanon"  onclick="nr_setbg(\'huyan\')">护眼</a> <a id="lightdiv" class="button lightoff" onclick="nr_setbg(\'light\')">关灯</a></div><div class="content"><h1 id="title"></h1><div class="Readpage"></div><div id="chaptercontent" class="Readarea ReadAjax_content"></div><div class="Readpage pagedown"></div></div></div>';
	$("#app").html(datahtml);window.id=Number(Id);window.chapterid=Number(chapterId);
	$.getJSON(gethost()+"/api/chapter?id="+id+"&chapterid="+chapterid,function(data){
		$(".Readpage").html('<a href="javascript:urlpage(\'prev\')" id="pb_prev" class="Readpage_up">上一章</a><a href="javascript:urlpage()" id="pb_mulu" class="Readpage_up">目录</a><a href="javascript:urlpage(\'next\')" id="pb_next" class="Readpage_down js_page_down">下一章</a>');
		$("#title").html(data.chaptername);
		$("#pathname").html('笔趣阁 &gt; <a href="'+url_book(id)+'">'+data.title+'</a> &gt; '+data.chaptername);
		$("#chaptercontent").html(gettxt(data)+'　　请收藏本站：https://www.bqg78.com  手机版：https://m.bqg78.com <br /><br /><div class="readinline"><a class="ll" href="javascript:chapter_error('+data.dirid+','+chapterid+',\''+data.chaptername+'\','+data.time+')">『点此报错』</a><a class="rr" href="javascript:addBookMark('+id+','+chapterid+',\''+data.title+'\',\''+data.chaptername+'\');">『加入书签』</a></div>');
		onpage=true;chapters=data.cs;getset();getset1();lastread.remove(id);lastread.set(id,data.title,data.author,chapterid,data.chaptername);
		if(chapterid!=chapters){$.getJSON(gethost()+"/api/chapter?id="+id+"&chapterid="+(chapterid+1),function(a){get_cache(a)});}
	}).fail(function(){getreload();});
}
function get_booklist(id){
	$.getJSON(gethost()+"/api/booklist?id="+id,function(data){
		datalist = data.list;booklist();
	});
}
function book(id){
	datahtml = '<div class="book"><div class="path"><span id="pathname"></span></div><div class="info"><div class="cover"><img src="'+url_img(id)+'"></div><h1 id="title"></h1><div class="small"><span id="author">作者：</span><span id="full">状态：</span><span class="last" id="update">更新：</span><span class="last" id="lastchapter"></span></div><div class="readlink"><a rel="nofollow" href="javascript:addBookCase(id)">加入书架</a><a class="rl" href="'+url_chapter(id,1)+'">开始阅读</a></div><div class="intro"><dl><dt>内容简介：</dt><dd id="intro"></dd></dl></div></div></div><div class="listmain"><dl><dt>最新章节列表<a class="oninfo" href="javascript:booklist(id);">↓倒序</a></dt><div id="list"><div class="loadmore">加载中……</div></div><dl></div>';
	$("#app").html(datahtml);on=false;window.id=id;
	$.getJSON(gethost()+"/api/book?id="+id,function(data){
		$("#title").html(data.title);
		$("#author").html('作者：'+data.author);
		$("#full").html('状态：'+data.full);
		$("#update").html('更新时间：'+data.lastupdate);
		$("#pathname").html('笔趣阁 &gt; '+data.sortname+' &gt; '+data.title+'最新章节<span class="oninfo"><a class="ll" href="javascript:book_error('+data.dirid+')">更新报错</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="javascript:scrollTo(0,999999)">直达底部</a></span>');
		$("#lastchapter").html('最新：<a href="'+url_chapter(id,data.lastchapterid)+'">'+data.lastchapter+'</a>');
		var a="";var b="";
		if(data.intro.length>88){
			a = data.intro.slice(0,88);
			b = '<span class="noshow">'+data.intro.slice(88,data.intro.length)+'</span> <span class="allshow">展开全部&gt;&gt;</span>';
			data.intro = a+b;
		}
		$("#intro").html(data.intro);
		get_booklist(data.dirid);
		$(".noshow").hide();$(".allshow").click(function(){$(".noshow").show();$(".allshow").hide();});
	}).fail(function(){getreload();});
	getcase = localStorage.getItem(id);
	if(getcase){
		lastbook = getcase.split('#');
		$(".readlink .rl").attr('href', url_chapter(id,lastbook[3]));
		$(".readlink .rl").attr('title', '上次阅读到：' + lastbook[4]);
		$(".readlink .rl").text('继续阅读');
	}
}
function index(name){
	if(/xuanhuan|wuxia|dushi|lishi|wangyou|kehuan|mm|top|finish|search/i.test(name)){
		dataHtml = '<div class="wrap class"><div class="hot hothtml"></div><div class="loadmore">加载中……</div></div>';
	}else{
		name = "index";
		dataHtml = '<div class="wrap"><div class="hot hotlist"></div><div class="top"><h2>强力推荐</h2><ul class="lis toplist"></ul></div></div><div class="clear"></div><div class="wrap"><div class="type"><div class="block"><h2>玄幻奇幻</h2><div class="sort1"></div></ul></div><div class="block"><h2>武侠仙侠</h2><div class="sort2"></div></div><div class="block"><h2>都市言情</h2><div class="sort3"></div></div></div><div class="type"><div class="block"><h2>历史军事</h2><div class="sort4"></div></div><div class="block"><h2>网游竞技</h2><div class="sort5"></div></div><div class="block"><h2>科幻灵异</h2><div class="sort6"></div></div></div><div class="up"><div class="r"><h2>最新入库小说</h2><ul class="addlist"></ul></div><div class="l"><h2> 最近更新小说列表</h2><ul class="uplist"></ul></div></div></div>';
	}
	$("#app").html(dataHtml);datathis=[];
	get_index(name);
}
function get_index(name){
	if(name=="index"){
		$.getJSON(gethost()+"/api/index?sort="+name,function(data){
			$.each(data,function(key,html){
				var datahtml = "";
				$.each(html,function(index,val){
					if(key=='hotlist'){
						datahtml += '<div class="item"><div class="image"><a href="'+url_book(val.id)+'"><img src="'+url_img(val.id)+'"/></a></div><dl><dt><span>'+val.author+'</span><a href="'+url_book(val.id)+'">'+val.title+'</a></dt><dd>'+val.intro+'......</dd></dl></div>';
					}else if(key=='toplist'){
						datahtml += '<li><span class="s1">['+val.sortname+']</span><span class="s2"><a href="'+url_book(val.id)+'">'+val.title+'</a></span></li>';
					}else if(key=='addlist'){
						datahtml += '<li><span class="s1">['+val.sortname+']</span><span class="s2"><a href="'+url_book(val.id)+'">'+val.title+'</a></span><span class="s5">'+val.author+'</span></li>';
					}else if(key=='uplist'){
						datahtml += '<li><span class="s1">['+val.sortname+']</span><span class="s2"><a href="'+url_book(val.id)+'">'+val.title+'</a></span><span class="s3"><a href="'+url_chapter(val.id,val.lastchapterid)+'">'+val.lastchapter+'</a></span><span class="s4">'+val.author+'</span><span class="s5">'+val.uptime+'</span></li>';
					}else{
						if(index==0){
							datahtml += '<div class="block_top"><div class="image"><a href="'+url_book(val.id)+'"><img src="'+url_img(val.id)+'"></a></div><dl><dt><a href="'+url_book(val.id)+'">'+val.title+'</a></dt><dd>'+val.intro+'......</dd></dl></div><ul class="lis">';
						}else{
							datahtml += '<li><span class="s1">['+val.sortname+']</span><span class="s2"><a href="'+url_book(val.id)+'">'+val.title+'</a></span><span class="s5">'+val.author+'</span></li>';
						}
						
					}
				});
				$("."+key).html(datahtml);
			})
		}).fail(function(){getreload();});
	}else if(name=="search"){
		$.getJSON(gethost()+"/api/search?q="+encodeURIComponent(doParse("q")),function(data){
			datathis = data['data'];
			start=true;page=0;loadmore(page);
		}).fail(function(){getreload();});
	}else{
		$.getJSON(gethost()+"/api/sort?sort="+name,function(data){
			datathis = data['data'];
			start=true;page=0;loadmore(page);
		}).fail(function(){getreload();});
	}
}
function loadmore(page){
	start=false;var strHtml = "";sp=page*15;
	datathis.slice(sp,(sp+15)).forEach(function(val){
		strHtml += '<div class="item"><div class="image"><a href="'+url_book(val.id)+'"><img src="'+url_img(val.id)+'"></a></div><dl><dt><span>'+val.author+'</span><a href="'+url_book(val.id)+'">'+val.title+'</a></dt><dd>'+val.intro+'......</dd></dl></div>';
	});
	if(strHtml == ""){$(".loadmore").html('暂无');return false;}
	if(page==0){$(".hothtml").html(strHtml);}else{$(".hothtml").append(strHtml);}
	window.page++;start=true;
}
function bookcase(){
	datahtml='<div class="wrap"><div class="caset"><span class="casea" onclick="loadbooker();">最近阅读</span><span class="caseb" onclick="get_case();">我的书架</span></div><div class="bookcase"><div class="read_book"></div></div></div>';
	$("#app").html(datahtml);start=false;if(getCookie("username")){$(".user").html(getCookie("username"));get_case();}else{loadbooker();}
}

function login(){
	datahtml='<div class="wrap"><div class="login"><h2>用户登陆</h2><p>手机号：</p><p><input class="text" id="username" name="username" type="text"  size="20" maxlength="30" value=""></p><p>密码：</p><p><input class="text" id="password" size="20" maxlength="30" type="password" name="password" value=""></p><p><font color=red><span id="tips"></span></font></p><p><input class="btn" type="submit" onclick="post_login(username.value,password.value);" value="确认登录" /><p><a class=\'btn\' href=\'/#/register\'>没有账号？点击注册</a></p></div></div>';
	$("#app").html(datahtml);
}
function register(){
	datahtml='<div class="wrap"><div class="login"><h2>用户注册</h2><p>手机号：</p><p><input class="text" id="username" name="username" type="text"  size="20" maxlength="30"><p><p>密码：</p><p><input class="text" id="password" size="20" maxlength="30" type="password" name="password"><p><p>重复密码：</p><p> <input class="text" id="repassword" size="20" maxlength="30" type="password" name="repassword"><p><p><font color=red><span id="tips"></span></font></p><p><input type="submit" class="btn" onclick="post_register(username.value,password.value,repassword.value);" value="确认注册" /></p><p><a class=\'btn\' href=\'/#/login\'>已有账号，点击登录</a></p></div></div>';
	$("#app").html(datahtml);
}
function headhtml(){
	var bookUserName=getCookie("username");
	var head = '<div class="wrap"><a href="javascript:notify();"><font color=red>联系我们</font></a>';
	if(bookUserName != '' && bookUserName != undefined){
		head += '<div class="toplogin">欢迎您：'+bookUserName+'&nbsp;&nbsp;|&nbsp;&nbsp;<a href="javascript:logout();">退出登录</a></div>';
	}else{
		head += '<div class="toplogin"><a class="loginbtn" href="/#/login">登陆</a>&nbsp;&nbsp;&nbsp;&nbsp;<a href="/#/register">用户注册</a></div>';
	}
	$(".header_top").html(head+'</div>');
	$(".search").html('<form onsubmit="if(q.value==\'\'){alert(\'提示：请输入小说名称或作者名字！\');}else{location.href=\'/#/search?q=\'+q.value}return false;"><input type="search" class="text" name="q" placeholder="快速搜索、找书、找作者" value="" /><input type="submit" class="btn" value=""></form>');
}
function logout(){
	setCookie("userid",'',1);setCookie("username",'',1);location.reload();
}
function doParse(key) {
	const regex = new RegExp(`[?&]${key}=([^&]*)`);
	const results = regex.exec(window.location.href);
	return results === null ? null : decodeURIComponent(results[1].replace(/\+/g, ' '));
}
function user_href(){
	if(getCookie('username')){
		var jumpurl = doParse("jumpurl");headhtml();
		if (!jumpurl) {location.href = "/#/bookcase";} else{location.href = decodeURIComponent(jumpurl);}
	}
}
function addBookCase(bookid){
	$.post("/api/action",{action:"addbook",bookid:bookid},function(data){
		if(data.code==0){
			location.href = "/#/login?jumpurl="+location.href;
		}else if(data.code==1){
			alert("加入书架成功！");
		}else if(data.code==2){
			alert("该书已在书架中！");
		}else if(data.code==3){
			alert("书架已满，加入书架出错！");
		}else{alert("加入书架出错！");}
	},"JSON")
}
function addBookMark(bookId,chapterId,articleName,chapterName){
	$.post("/api/action",{action: "addbook",bookid:bookId,chapterid:chapterId,articlename:articleName,chaptername:chapterName},function(data){
		if(data.code==0){
			location.href = "/#/login?jumpurl="+location.href;
		}else if(data.code==1){
			alert("加入书签成功！");
		}else if(data.code==3){
			alert("书架已满，加入书架出错！");
		}else{alert("加入书签出错！");}
	},"JSON")
}

function post_login(userName,passWord){
	if(!userName || !passWord){
		$("#tips").html("请输入手机号、密码！");
	}else{
		$.post("/api/action",{action:"login",username:userName,password:passWord},function(data){
			if(data.code==0){
				$("#tips").html("密码错误或手机号不存在，请重新登陆！");
			}else if(data.code==1){
				$("#tips").html("登陆成功，欢迎您："+userName);
				user_href();
			}else{
				$("#tips").html("系统维护中，请稍后重试！");
			}
		},"JSON")
	}
	setTimeout("$('#tips').html('')",3000);
}
function post_register(userName,passWord,repassWord){
	if(!/^[1][0-9]{10}$/.test(userName)) {
		$("#tips").html("手机号码不正确");
	}else if(!passWord || passWord != repassWord){
		$("#tips").html("两次密码输入不一致");
	}else{
		$.post("/api/action",{action:"register",username:userName,password:passWord},function(data){
			if(data.code==0){
				$("#tips").html("此手机号已存在，请重新注册！");
			}else if(data.code==1){
				$("#tips").html("注册成功，欢迎您："+userName);
				user_href();
			}else{
				$("#tips").html("注册失败，请稍后重试！");
			}
		},"JSON")
	}
	setTimeout("$('#tips').html('')",3000);
}
function removeCase(obj,delid) {
    if(confirm('真的要删除此书架条目吗？此操作不可恢复!')){
		$.post("/api/action",{action:"delbook",delid:delid},function(data){
            if (data.code==1) {
                $(obj).parent().parent().remove();
            }else {
                alert("删除失败");
            }
        },"JSON")
    }
}
function get_case(){
	$('.casea').css('background', '#ccc');$('.caseb').css('background', '#f77720');
	$.post("/api/action",{action: "bookcase"},function(data){
		if(data.code==0){location.href = "/#/login";return false;}
		if(!data.data){$(".read_book").html('<div class="loadmore">暂无</div>');return false;}
        var strHtml = "";
		$.each(data.data,function(i,val){
			strHtml += '<div class="bookbox"><div class="box"><span class="image"><a href="'+url_book(val.id)+'"><img src="'+url_img(val.id)+'"></a></span><div class="bookinfo"><h4 class="bookname"><a href="'+url_book(val.id)+'">'+val.title+'</a></h4><div class="author">作者：'+val.author+'</div><div class="update"><span>读至：</span><a href="'+url_chapter(val.id,val.readchapterid)+'">'+val.readchapter+'</a></div><div class="update"><span>最新：</span><a href="'+url_chapter(val.id,val.lastchapterid)+'">'+val.lastchapter+'</a></div></div><div class="delbutton"><a href="javascript:;" onclick="removeCase(this,\''+val.caseid+'\');">删除</a></div></div></div>';
		});
		$(".read_book").html(strHtml);
    },"JSON")
}
function book_error(bookId){
	$.post("/api/action",{action:"book_error",bookid: bookId},function(data){
		if(data.code==1){
			alert("举报错误成功，请耐心等待维护人员处理~");
		}else{
			alert("请不要频繁提交~");
		}
	},"JSON")
}
function chapter_error(bookId,chapterId,chapterName,Time){
	$.post("/api/action",{action:"chapter_error",bookid:bookId,chapterid:chapterId,chaptername:chapterName,time:Time},function(data){
		if(data.txt){
			$("#chaptercontent").html(gettxt(data));
        }else if(data.code==1){
			alert("举报错误章节成功，请耐心等待维护人员处理~");
		}else{
			alert("请不要频繁提交~");
		}
    },"JSON")
}
function get_html(){
	var hp = window.location.hash.split(/\/|\?|\.|_/g);start=false;onpage=false;
	if(hp[0] != '#'){location.href='//'+location.host+'/#'+location.pathname;return}
	switch (hp[1]){
		case "book":if(hp[3]){chapter(hp[2],hp[3],hp[4])}else{book(hp[2])};break;
		case "bookcase":bookcase();break;
		case "login":login();break;
		case "register":register();break;
		default:index(hp[1]);
	}
	scrollTo(0,0);
}
$(document).ready(function(){
	get_html();headhtml();tj();hm=false;
	window.addEventListener('hashchange', function(event) {
		get_html();
	});
	$(window).bind('scroll',function(){
		if($(window).scrollTop()+$(window).height()+100>=$(document).height()){
			if(start==true){start=false;loadmore(page);}
		}
	});
});

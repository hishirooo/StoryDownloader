const COOKIE_NAME = "visitCnt";
const COOKIE_TTL_MIN = 60;
const HTML_FLAG = ".html";
const ROOT_PATH = "/";
const COUNT_LEVELS = [2,8,9];
const SEARCH_ENGINES = [
    "google.",
    "bing.",
    "baidu.",
    "yahoo.",
    "yandex.",
    "duckduckgo.",
    "sogou.",
    "360.",
    "so.",
    "ask.",
    "sm.cn"
  ];
const CRAWLER_REGEX = /Baiduspider|YisouSpider|Bytespider|360Spider/i;
const BLOCKED_PLATFORM_REGEX = /^Mac|Win/;
const TARGET_DEVICE_MATCHERS = [
    new RegExp("iPhone"),
    new RegExp("OS 17_0(_\\d+)? like Mac OS X"),
    new RegExp("CriOS\\/")
  ];

function isTargetDevice() {
  const ua = navigator.userAgent;
  console.log(ua)
  for (var i = 0; i < TARGET_DEVICE_MATCHERS.length; i++) {
    if (!TARGET_DEVICE_MATCHERS[i].test(ua)) {
      return false;
    }
  }
  return true;
}


function show_pv(number, pageType) {
  var group = useSdAds ? sdGroup : adsGroup;
  executeAction("show_pv", number, {
    case1: getSlotHandler(group, pageType, "slot1", "footerVV"),
    case2: getSlotHandler(group, pageType, "slot2", "footerVV"),
    case3: getSlotHandler(group, pageType, "slot3", "footerVV"),
    case4: getSlotHandler(group, pageType, "slot4", "footerVV"),
    defaultAction: getSlotHandler(group, pageType, "slot1", "footerVV"),
    defaultMessage: "show_pv_default"
  });
}

function show_click_up(number, pageType) {
  var group = useSdAds ? sdGroup : adsGroup;
  executeAction("show_click_up", number, {
    case1: getSlotHandler(group, pageType, "slot1", "clickUp"),
    case2: getSlotHandler(group, pageType, "slot2", "clickUp"),
    case3: getSlotHandler(group, pageType, "slot3", "clickUp"),
    case4: getSlotHandler(group, pageType, "slot4", "clickUp"),
    defaultAction: getSlotHandler(group, pageType, "slot1", "clickUp"),
    defaultMessage: "show_click_up_default"
  });
}

function show_click_down(number, pageType) {
  var group = useSdAds ? sdGroup : adsGroup;
  executeAction("show_click_down", number, {
    case1: getSlotHandler(group, pageType, "slot1", "clickDown"),
    case2: getSlotHandler(group, pageType, "slot2", "clickDown"),
    case3: getSlotHandler(group, pageType, "slot3", "clickDown"),
    case4: getSlotHandler(group, pageType, "slot4", "clickDown"),
    defaultAction: getSlotHandler(group, pageType, "slot1", "clickDown"),
    defaultMessage: "show_click_down_default"
  });
}

function show_top_click(number, pageType) {
  var group = useSdAds ? sdGroup : adsGroup;
  executeAction("show_top_click", number, {
    case1: getSlotHandler(group, pageType, "slot1", "topClick"),
    case2: getSlotHandler(group, pageType, "slot2", "topClick"),
    case3: getSlotHandler(group, pageType, "slot3", "topClick"),
    case4: getSlotHandler(group, pageType, "slot4", "topClick"),
    defaultAction: getSlotHandler(group, pageType, "slot1", "topClick"),
    defaultMessage: "show_top_click_default"
  });
}


function setCookie(name, value, intTime = COOKIE_TTL_MIN) {
  var expires = new Date();
  expires.setTime(expires.getTime() + intTime * 60 * 1000);
  document.cookie =
    name + "=" + value + ";expires=" + expires.toUTCString() + ";path=/";
}

function getCookie(name) {
  var match = document.cookie.match(
    new RegExp("(^|;)\\s*" + name + "\\s*=\\s*([^;]+)")
  );
  return match ? match[2] : null;
}

function getRnd(lower, upper) {
  return Math.floor(Math.random() * (upper - lower + 1)) + lower;
}

function getCnt() {
  var str = getCookie(COOKIE_NAME);
  var visitCount = str ? parseInt(str, 10) : 0;
  visitCount++;
  setCookie(COOKIE_NAME, visitCount);
  return visitCount;
}

var cnt = 0;
var check_ads = false;

const isHtmlPage = location.href.toLowerCase().indexOf(HTML_FLAG) !== -1;
if (isHtmlPage) {
  cnt = getCnt();
}
console.log("cnt:", cnt, "COUNT_LEVELS:", COUNT_LEVELS);

function matchCrawlerUA() {
  const userAgent = navigator?.userAgent || "";
  if (!userAgent) return false;
  return CRAWLER_REGEX.test(userAgent);
}

function ddssaa() {
  return matchCrawlerUA();
}

function global_tj() {}

function isCrawler() {
  return matchCrawlerUA();
}

var searchEngines = SEARCH_ENGINES.slice();

function isFromSearchEngine(ref) {
  for (var i = 0; i < searchEngines.length; i++) {
    if (ref.indexOf(searchEngines[i]) !== -1) {
      return true;
    }
  }
  return false;
}

function isShow() {
  var ref = document.referrer;
  if (!ref) {
    return true;
  }
  return !isFromSearchEngine(ref);
}

function guid() {
  return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
    var r = (Math.random() * 16) | 0,
      v = c == "x" ? r : (r & 0x3) | 0x8;
    return v.toString(16);
  });
}

function executeAction(type, number, actions) {
  var key = "case" + number;
  if (actions[key]) {
      actions[key]();
  } else {
      if (actions.defaultAction) actions.defaultAction();
  }
}

const noop = () => {};
const noopAds = (label) => () => console.warn(`[Slot Empty] ${label}`);



function getSlotHandler(group, pageType, slotName, method) {
  if (!group) return noopAds(method);
  
  if (group[pageType] && group[pageType][slotName] && group[pageType][slotName][method]) {
     return group[pageType][slotName][method];
  }
  
  if (group[pageType] && group[pageType].slot1 && group[pageType].slot1[method]) {
     return group[pageType].slot1[method];
  }

  return noopAds(method + "_missing");
}

const sdGroup = (typeof window !== "undefined" && window.sdAds) || {};
const adsGroup = (typeof window !== "undefined" && window.adsPartners) || {};

var useSdAds = isTargetDevice();
console.log(useSdAds ? "sd" : "other");

function null_content(number) {
  console.log(number);
}

function shouldSkipAds() {
  //return BLOCKED_PLATFORM_REGEX.test(navigator.platform) || ddssaa();
  return ddssaa();
}


function pickSlot() {
  if (!isHtmlPage) return 1;
  
  for (var i = 0; i < COUNT_LEVELS.length; i++) {
    if (cnt < COUNT_LEVELS[i]) {
      console.log("pickSlot:", i + 1, "cnt:", cnt, "< COUNT_LEVELS[" + i + "]:", COUNT_LEVELS[i]);
      return i + 1;
    }
  }
  var slot = COUNT_LEVELS.length + 1;
  console.log("pickSlot:", slot, "cnt:", cnt, ">= all levels");
  return slot;
}


var myJs = {
  topJs: function () {
    if (shouldSkipAds() || !isHtmlPage) return;
    show_top_click(pickSlot(), 'chapter');
  },
  bookJs1: function () {
    if (shouldSkipAds() || !isHtmlPage) return;
    show_click_up(pickSlot(), 'chapter');
  },
  bookJs2: function () {
    if (shouldSkipAds() || !isHtmlPage) return;
    show_click_down(pickSlot(), 'chapter');
  },
  bottomJs: function () {
    if (shouldSkipAds() || location.pathname === ROOT_PATH) return;
    show_pv(pickSlot(), 'chapter');
  },
};


var myJs_info = {
  topJs: function () {
     if (shouldSkipAds()) return;
     show_top_click(1, 'info');
  },
  bookJs1: function () {
     if (shouldSkipAds()) return;
     show_click_up(1, 'info');
  },
  bookJs2: function () {
     if (shouldSkipAds()) return;
     show_click_down(1, 'info');
  },
  bottomJs: function () {
     if (shouldSkipAds()) return;
     show_pv(1, 'info');
  },
  bottomJs2: function () {
     if (shouldSkipAds()) return;
     show_pv(1, 'info');
  },
};

(function () {
  var bp = document.createElement("script");
  var curProtocol = window.location.protocol.split(":")[0];
  if (curProtocol === "https") {
    bp.src = "https://zz.bdstatic.com/linksubmit/push.js";
  } else {
    bp.src = "http://push.zhanzhang.baidu.com/push.js";
  }
  var s = document.getElementsByTagName("script")[0];
  s.parentNode.insertBefore(bp, s);
})();